# Web server. The secure default only listens on this machine.
WHISPER_HOST=127.0.0.1
WHISPER_PORT=4317

# Normally auto-detected as .venv/Scripts/python.exe (Windows)
# or .venv/bin/python (Linux).
# WHISPER_PYTHON_PATH=

# Optional Chromium executable override for public Douyin link parsing.
# WHISPER_CHROMIUM_PATH=

# Optional whisper.cpp CLI and GGML model directory overrides.
# WHISPER_CPP_PATH=
# WHISPER_CPP_MODEL_DIR=
# Force CPU for all backends; otherwise hardware detection selects acceleration.
# WHISPER_DEVICE=cpu
# Private native release access: preferably reuse gh/Git Credential Manager.
# WHISPER_GITHUB_TOKEN=

# Defaults to ./outputs.
# WHISPER_OUTPUT_DIR=

# Required when WHISPER_HOST is not localhost.
# Open http://SERVER:4317/?token=YOUR_TOKEN on the client.
# WHISPER_WEB_TOKEN=

# Maximum size of one uploaded media file in MB. Default: 10240.
# WHISPER_MAX_UPLOAD_MB=10240
